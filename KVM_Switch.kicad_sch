	)
	(text "Two HDMI inputs per computer\nTwo independently extended HDMI monitors\nTwo USB-C data-only upstream ports\nExternal USB-C to HDMI adapter per laptop\nNo charging or EDID emulation"
		(exclude_from_sim no)
		(at 72 135 0)
